// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ADMIN = Owner/Admin. STAFF is the original pre-ERP role, kept so existing
// rows stay valid — the app treats it exactly like MANAGER.
enum Role {
  ADMIN
  STAFF
  MANAGER
  OPERATOR
  SALES
}

model Setting {
  id          String   @id @default("singleton")
  appName     String   @default("Inventory Manager")
  locations   String   @default("Surat,Mumbai")
  accentColor String   @default("#18181b")
  updatedAt   DateTime @updatedAt

  // Stones out with a karigar/department longer than this are highlighted
  // on the Pending report.
  pendingAlertDays Int @default(7)
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Lets a MANAGER see cost, profit, and rough price (ADMIN always can).
  canSeeCosts Boolean @default(false)
  // Deactivated users can't sign in; kept for history instead of deleted.
  active      Boolean @default(true)

  transactions Transaction[]
  departments  UserDepartment[]
  stoneEvents  StoneEvent[]
  auditLogs    AuditLog[]
  attachments  Attachment[]

  movementsIssued   ProcessMovement[] @relation("MovementIssuedBy")
  movementsReturned ProcessMovement[] @relation("MovementReturnedBy")
  movementsReviewed ProcessMovement[] @relation("MovementExcessReviewedBy")
  movementsVoided   ProcessMovement[] @relation("MovementVoidedBy")
  breakagesRecorded Breakage[]
  splitsRecorded    StoneSplit[]
}

model Product {
  id               String           @id @default(cuid())
  sku              String           @unique
  name             String
  unit             String           @default("pcs")
  reorderLevel     Int              @default(0)
  stock            Int              @default(0)
  location         String?
  certificationLab CertificationLab @default(NONE)

  // Quality attributes (gemstones)
  caratWeight Float?
  color       String?
  clarity     String?
  cutGrade    String?

  // Pricing (per unit)
  costPrice    Float @default(0)
  sellingPrice Float @default(0)

  lot   Lot?    @relation(fields: [lotId], references: [id])
  lotId String?

  // Where this specific SKU sits in the manufacturing process, independent
  // of the lot's overall status (a lot's stones don't all move in lockstep).
  // Kept in sync with the latest ProcessLog entry for this product.
  stage LotStatus @default(ROUGH)

  // Denormalized "where is this stone right now" — null means it's available
  // (freshly lotted, or returned and not yet issued elsewhere). Kept in sync
  // by issuing/returning a ProcessMovement, so Manufacturing lists don't need
  // to derive it from history on every read.
  currentProcess ProcessName?
  currentParty   Party?       @relation("CurrentlyHolding", fields: [currentPartyId], references: [id])
  currentPartyId String?

  // ERP: the configurable stage/department the stone is at right now — the
  // successor to `currentProcess`, kept in sync with it while both exist.
  currentStage        ProcessStage? @relation(fields: [currentStageId], references: [id])
  currentStageId      String?
  currentDepartment   Department?   @relation(fields: [currentDepartmentId], references: [id])
  currentDepartmentId String?

  // Lifecycle status and physical location for the whole life of the stone
  // (rough → polished → sold), not just the Polish stage.
  status          StoneStatus   @default(IN_PRODUCTION)
  stockLocation   StoneLocation @default(FACTORY)
  locationParty   Party?        @relation("StoneLocationParty", fields: [locationPartyId], references: [id])
  locationPartyId String?

  // Weight at lotting, frozen — the base for yield %. `caratWeight` stays
  // the stone's current weight.
  roughWeight Decimal? @db.Decimal(12, 3)

  // Splitting: one rough becomes several children, each its own stone.
  parent   Product?  @relation("StoneSplit", fields: [parentId], references: [id])
  parentId String?
  children Product[] @relation("StoneSplit")

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions  Transaction[]
  processLogs   ProcessLog[]
  movements     ProcessMovement[]
  polishedStone PolishedStone?
  events        StoneEvent[]
  breakages     Breakage[]
  splits        StoneSplit[]

  @@index([lotId])
  @@index([currentPartyId])
  @@index([status])
  @@index([stockLocation])
  @@index([parentId])
  @@index([currentStageId])
  @@index([currentDepartmentId])
  @@index([createdAt])
}

enum StoneStatus {
  IN_PRODUCTION
  POLISHED
  AT_LAB
  IN_STOCK
  ON_MEMO
  SOLD
  RETURNED
  SPLIT
  BROKEN
}

enum StoneLocation {
  FACTORY
  OFFICE_SAFE
  ON_MEMO
  AT_LAB
  IN_TRANSIT
  SOLD
}

enum ProcessName {
  GALAXY
  PLANNING
  GREEN_SAWING
  QUAZER_SAWING
  WATERJET_SAWING
  BRUTING
  CHABKA
  POLISHING
}

// One issue-and-return cycle for a single stone: sent to a process/party,
// later returned. The stone's currentProcess/currentParty reflect whichever
// movement is still open (returnDate null). A printed Memo groups every
// movement created in the same Issue action.
model ProcessMovement {
  id           String       @id @default(cuid())
  // The old hardcoded process. Optional since ERP stages: a stage added in
  // Settings (e.g. Marking) has no enum value — `stage` is the source of truth.
  process      ProcessName?
  issueDate    DateTime     @default(now())
  issueWeight  Float?
  returnDate   DateTime?
  returnWeight Float?
  notes        String?
  createdAt    DateTime     @default(now())

  // Set only when this stone already has a completed movement at this same
  // process — required at issue time so a re-cut, redo, etc. is explained,
  // not just silently counted as rework.
  reissueReason String?

  // The labor cost charged for this specific issue — auto-filled from the
  // karigar's current ProcessRate at issue time, editable. Stored on the
  // movement itself (not looked up later) so a later rate change never
  // rewrites what a past movement actually cost.
  laborCost Float?

  // Total weight of cut-off pieces ("tops") removed during this movement —
  // set on return, mainly for Laser Sawing where a stone can be cut from
  // several angles before its final weight is known.
  topsWeight Float?

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  party   Party?  @relation(fields: [partyId], references: [id])
  partyId String?

  memo   Memo?   @relation(fields: [memoId], references: [id])
  memoId String?

  // ─── ERP manufacturing ───
  stage            ProcessStage? @relation(fields: [stageId], references: [id])
  stageId          String?
  // Issued from one department to a karigar (`party`) or to another
  // department (`toDepartment`, no karigar).
  fromDepartment   Department?   @relation("MovementFrom", fields: [fromDepartmentId], references: [id])
  fromDepartmentId String?
  toDepartment     Department?   @relation("MovementTo", fields: [toDepartmentId], references: [id])
  toDepartmentId   String?
  issuedBy         User?         @relation("MovementIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedById       String?
  returnedBy       User?         @relation("MovementReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  returnedById     String?
  issuePieces      Int           @default(1)
  returnPieces     Int?
  condition        String?
  returnRemark     String?

  // Loss = issue weight − return weight − tops (recovered cut pieces), in
  // carats and as % of issue weight. `lossLimitPct` is the allowed loss that
  // applied at return time, kept so later limit changes don't rewrite history.
  lossWeight         Decimal?  @db.Decimal(12, 3)
  lossPct            Decimal?  @db.Decimal(7, 3)
  lossLimitPct       Decimal?  @db.Decimal(7, 3)
  isExcessLoss       Boolean   @default(false)
  excessReason       String?
  excessReviewedBy   User?     @relation("MovementExcessReviewedBy", fields: [excessReviewedById], references: [id], onDelete: SetNull)
  excessReviewedById String?
  excessReviewedAt   DateTime?
  excessReviewNote   String?

  // Undone entries are voided, never deleted — they carry labour cost.
  voidedAt   DateTime?
  voidedBy   User?     @relation("MovementVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidedById String?
  voidReason String?

  breakages Breakage[]

  labourEntry   LabourEntry?
  jobWorkBill   JobWorkBill? @relation(fields: [jobWorkBillId], references: [id])
  jobWorkBillId String?

  @@index([productId])
  @@index([partyId])
  @@index([memoId])
  @@index([stageId])
  @@index([issueDate])
  @@index([returnDate])
  @@index([isExcessLoss])
  @@index([toDepartmentId])
  @@index([jobWorkBillId])
}

// The printed voucher handed to a party when stones are issued to them —
// one memo per Issue action, listing every stone (via its movements) with
// its weight, for the party to sign as acknowledgment of receipt.
model Memo {
  id         String       @id @default(cuid())
  memoNumber String       @unique
  process    ProcessName?
  date       DateTime     @default(now())
  createdAt  DateTime     @default(now())

  // Issued to a karigar (party) or, since ERP, to a department.
  party        Party?        @relation(fields: [partyId], references: [id], onDelete: Restrict)
  partyId      String?
  department   Department?   @relation(fields: [departmentId], references: [id])
  departmentId String?
  stage        ProcessStage? @relation(fields: [stageId], references: [id])
  stageId      String?

  movements ProcessMovement[]

  @@index([partyId])
}

// A finished stone gets a new Stock ID here once transferred out of
// Manufacturing — separate numbering from its manufacturing-stage SKU, with
// full certificate/grading detail and a traceable link back to that SKU
// (and, through it, to the Lot it was cut from).
model PolishedStone {
  id           String    @id @default(cuid())
  stockId      String    @unique
  certified    Boolean   @default(false)
  certLab      String?
  certNumber   String?
  // How the stone is actually sold — separate from `certified`, since a
  // certified stone can still be sold within a loose parcel rather than
  // marketed individually.
  saleType     SaleType?
  shape        String?
  caratWeight  Float?
  color        String?
  clarity      String?
  cutGrade     String?
  polishGrade  String?
  symmetry     String?
  fluorescence String?
  measurements String?
  notes        String?
  createdAt    DateTime  @default(now())

  sourceProduct   Product @relation(fields: [sourceProductId], references: [id])
  sourceProductId String  @unique

  // Sales tracking — the app stops tracking a stone at transfer otherwise,
  // with no way to record who bought it, for how much, or what it cost.
  status      PolishStatus @default(AVAILABLE)
  location    String?
  askingPrice Float?
  currency    String       @default("USD")

  buyer   Party?  @relation("PolishedStoneBuyer", fields: [buyerId], references: [id])
  buyerId String?

  soldPrice     Float?
  soldDate      DateTime?
  paymentStatus PaymentStatus?

  // Cost components — total cost is computed in the app (sum of these),
  // not stored as its own column.
  roughCostAlloc Float?
  laborCost      Float?
  certCost       Float?
  otherCost      Float?

  @@index([buyerId])
  @@index([status])
}

enum PolishStatus {
  AVAILABLE
  RESERVED
  ON_MEMO
  SOLD
}

enum SaleType {
  CERTIFIED_SINGLE
  NON_CERTIFIED_SINGLE
  LOOSE_PARCEL
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum LotStatus {
  ROUGH
  GALAXY
  SAWING
  CUTTING
  POLISHING
  CERTIFICATION
  COMPLETED
}

enum CertificationLab {
  NONE
  GIA
  IGI
}

// A single step a stone went through — which process, who did it (party),
// and when. A product's full manufacturing history is its list of these.
model ProcessLog {
  id        String    @id @default(cuid())
  stage     LotStatus
  date      DateTime  @default(now())
  notes     String?
  createdAt DateTime  @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  party   Party?  @relation(fields: [partyId], references: [id])
  partyId String?

  @@index([productId])
  @@index([partyId])
}

enum ExpenseCategory {
  ROUGH_PURCHASE
  SAWING
  CUTTING
  POLISHING
  CERTIFICATION
  OTHER
}

model Lot {
  id             String    @id @default(cuid())
  lotNumber      String    @unique
  roughWeight    Float?
  polishedWeight Float?
  description    String?
  status         LotStatus @default(ROUGH)
  createdAt      DateTime  @default(now())

  // Total price paid for the whole rough lot — used to allocate a rough
  // cost share to each polished stone, proportional to its rough weight.
  purchaseCost Float?

  // Who the rough came from — a tender or a supplying party.
  sourceParty   Party?  @relation("LotSource", fields: [sourcePartyId], references: [id])
  sourcePartyId String?

  products Product[]
  expenses LotExpense[]
}

model LotExpense {
  id          String          @id @default(cuid())
  category    ExpenseCategory @default(OTHER)
  description String?
  amount      Float
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())

  // Optional rate-based entry: amount was computed as ratePerCarat times
  // the total carats of this lot's stones within [caratMin, caratMax].
  ratePerCarat Float?
  caratMin     Float?
  caratMax     Float?

  party   Party?  @relation(fields: [partyId], references: [id])
  partyId String?

  lot   Lot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lotId String

  @@index([lotId])
  @@index([partyId])
}

// A saved price list entry — what a given party charges per carat for a
// given process — so entering a lot expense (or, now, a Manufacturing
// issue's labor cost) doesn't mean retyping the same rate every time.
// Managed from Settings.
//
// `stage` (LotStatus) is the original field from the old Lots-expense
// feature and is no longer written by any current page — left as-is since
// it may still hold historical rows. `process` (ProcessName) is the field
// the current Manufacturing Issue flow reads and writes. A karigar's
// current rate for a process is whichever row has the latest
// `effectiveFrom` at or before now; adding a new row (rather than editing
// one in place) is how a rate change is recorded, so a past
// ProcessMovement's stored laborCost is never retroactively reinterpreted.
model ProcessRate {
  id            String       @id @default(cuid())
  stage         LotStatus?
  process       ProcessName?
  // Old per-carat rate. Still written for per-carat rows; `rate` + `basis`
  // are the source of truth since the ERP rate cards.
  ratePerCarat  Float?
  caratMin      Float?
  caratMax      Float?
  effectiveFrom DateTime     @default(now())
  createdAt     DateTime     @default(now())

  // A rate with no party is the default for the stage; a karigar's own rate
  // beats it. History is kept by adding rows, never editing them.
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId String?

  // ─── ERP rate card ───
  processStage   ProcessStage? @relation(fields: [processStageId], references: [id])
  processStageId String?
  basis          RateBasis     @default(PER_CARAT)
  rate           Decimal?      @db.Decimal(14, 2)
  currency       String        @default("INR")
  createdById    String?

  labourEntries LabourEntry[]

  @@index([stage])
  @@index([process])
  @@index([partyId])
  @@index([processStageId, partyId, effectiveFrom])
}

enum RateBasis {
  PER_CARAT
  PER_PIECE
  FIXED
}

enum TransactionType {
  IN
  OUT
}

enum PartyType {
  SUPPLIER
  CUSTOMER
  BOTH
}

// How a party is used in the manufacturing/sales workflow — distinct from
// the older, more generic `type` field. Drives which dropdown a party
// shows up in: tender/vendor on Lotting's source, karigar on Manufacturing
// Issue, customer on a Polish sale's buyer.
enum PartyCategory {
  TENDER_VENDOR
  KARIGAR
  CUSTOMER
}

model Party {
  id        String         @id @default(cuid())
  name      String         @unique
  type      PartyType      @default(BOTH)
  category  PartyCategory?
  // Deactivated, not deleted — old parties stay linked to historical
  // records (movements, sales, lots) and must never be removed outright.
  active    Boolean        @default(true)
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime       @default(now())

  // ERP: one party can play several roles. Supersedes `category`, which is
  // kept in sync for older screens.
  roles          PartyRoleType[] @default([])
  companyName    String?
  contactPerson  String?
  country        String?
  // e.g. {"gstin": "...", "pan": "...", "ein": "...", "iec": "..."}
  taxIds         Json?
  creditLimit    Decimal?        @db.Decimal(14, 2)
  creditCurrency String?

  stonesAtLocation Product[]    @relation("StoneLocationParty")
  stoneEvents      StoneEvent[]
  lossLimits       LossLimit[]
  breakagesHandled Breakage[]

  karigarProfile     KarigarProfile?
  karigarDepartments KarigarDepartment[]
  labourEntries      LabourEntry[]
  adjustments        KarigarAdjustment[]
  payrollRuns        PayrollRun[]
  jobWorkBills       JobWorkBill[]

  transactions         Transaction[]
  lotExpenses          LotExpense[]
  processLogs          ProcessLog[]
  processRates         ProcessRate[]
  processMovements     ProcessMovement[]
  memos                Memo[]
  lotsSourced          Lot[]             @relation("LotSource")
  stonesCurrentlyAt    Product[]         @relation("CurrentlyHolding")
  polishedStonesBought PolishedStone[]   @relation("PolishedStoneBuyer")

  @@index([roles], type: Gin)
}

enum PartyRoleType {
  VENDOR
  KARIGAR
  JOB_WORKER
  CUSTOMER
  BROKER
}

model Transaction {
  id        String          @id @default(cuid())
  type      TransactionType
  quantity  Int
  reference String?
  notes     String?
  createdAt DateTime        @default(now())

  product   Product @relation(fields: [productId], references: [id])
  productId String

  party   Party?  @relation(fields: [partyId], references: [id])
  partyId String?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([productId])
  @@index([createdAt])
  @@index([partyId])
}

// ─── ERP foundation ─────────────────────────────────────────────────────────

// A factory department (Planning, Sawing, Polishing, ...). Operators are
// limited to issue/return in the departments they're assigned to.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  stages     ProcessStage[]
  users      UserDepartment[]
  stonesHere Product[]

  karigars      KarigarDepartment[]
  movementsFrom ProcessMovement[]   @relation("MovementFrom")
  movementsTo   ProcessMovement[]   @relation("MovementTo")
  memos         Memo[]
}

model UserDepartment {
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String

  @@id([userId, departmentId])
  @@index([departmentId])
}

// Admin-editable process stages — the configurable successor to the
// hardcoded ProcessName enum. Stages that existed as enum values carry it in
// `legacyProcess`, which is how old movements map onto them.
model ProcessStage {
  id                  String       @id @default(cuid())
  code                String       @unique
  name                String
  sortOrder           Int          @default(0)
  department          Department?  @relation(fields: [departmentId], references: [id])
  departmentId        String?
  legacyProcess       ProcessName? @unique
  defaultLossLimitPct Decimal?     @db.Decimal(7, 3)
  isLabourBillable    Boolean      @default(true)
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())

  stonesHere    Product[]
  movements     ProcessMovement[]
  memos         Memo[]
  lossLimits    LossLimit[]
  rates         ProcessRate[]
  labourEntries LabourEntry[]

  @@index([departmentId])
}

// Append-only timeline of everything that happened to a stone — the source
// for the per-stone history view. Never updated in place.
model StoneEvent {
  id           String   @id @default(cuid())
  stone        Product  @relation(fields: [stoneId], references: [id], onDelete: Cascade)
  stoneId      String
  at           DateTime @default(now())
  type         String
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  party        Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partyId      String?
  weightBefore Decimal? @db.Decimal(12, 3)
  weightAfter  Decimal? @db.Decimal(12, 3)
  refType      String?
  refId        String?
  summary      String?
  data         Json?
  createdAt    DateTime @default(now())

  @@index([stoneId, at])
  @@index([type, at])
  @@index([refType, refId])
}

// Who changed what, when — old → new values for every write.
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId   String?
  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?

  @@index([entity, entityId])
  @@index([at])
  @@index([userId, at])
}

// Race-safe running numbers for documents (memo, stock ID, invoice, ...).
model Counter {
  key   String @id
  value Int    @default(0)
}

// Any uploaded file, attached to any record (invoice, KP certificate, plan
// file, breakage photo, certificate PDF, stone media, karigar photo).
model Attachment {
  id           String    @id @default(cuid())
  entityType   String
  entityId     String
  kind         String
  url          String
  thumbUrl     String?
  fileName     String?
  mime         String
  sizeBytes    Int
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([entityType, entityId])
}

// ─── ERP manufacturing ──────────────────────────────────────────────────────

// Allowed loss % for a stage, optionally for one karigar. The most specific
// limit wins (karigar + stage over the stage default on ProcessStage); the
// latest effectiveFrom at or before the return date applies, so changing a
// limit never rewrites past returns.
model LossLimit {
  id            String       @id @default(cuid())
  stage         ProcessStage @relation(fields: [stageId], references: [id])
  stageId       String
  party         Party?       @relation(fields: [partyId], references: [id])
  partyId       String?
  allowedPct    Decimal      @db.Decimal(7, 3)
  effectiveFrom DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@index([stageId, partyId, effectiveFrom])
}

// A stone damaged during manufacturing. Photos are Attachments
// (entityType "BREAKAGE").
model Breakage {
  id               String           @id @default(cuid())
  stone            Product          @relation(fields: [stoneId], references: [id])
  stoneId          String
  movement         ProcessMovement? @relation(fields: [movementId], references: [id])
  movementId       String?
  date             DateTime
  reason           String
  weightBefore     Decimal          @db.Decimal(12, 3)
  weightAfter      Decimal          @db.Decimal(12, 3)
  totalLoss        Boolean          @default(false)
  handledByParty   Party?           @relation(fields: [handledByPartyId], references: [id])
  handledByPartyId String?
  recordedBy       User             @relation(fields: [recordedById], references: [id])
  recordedById     String
  notes            String?
  createdAt        DateTime         @default(now())

  @@index([stoneId])
  @@index([date])
  @@index([handledByPartyId])
}

// One rough stone split into several children (each a Product with
// parentId set). Child rough weight — and, from Phase 4, cost — is the
// parent's, shared by weight.
model StoneSplit {
  id           String   @id @default(cuid())
  parent       Product  @relation(fields: [parentId], references: [id])
  parentId     String
  date         DateTime
  parentWeight Decimal  @db.Decimal(12, 3)
  childWeight  Decimal  @db.Decimal(12, 3)
  method       String   @default("WEIGHT")
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  recordedById String
  notes        String?
  createdAt    DateTime @default(now())

  @@index([parentId])
}

// File bytes for an Attachment when no external blob store is configured
// (local development, or before BLOB_READ_WRITE_TOKEN is set on Vercel).
model AttachmentData {
  attachmentId String @id
  data         Bytes
  thumb        Bytes?
}

// ─── ERP karigar / labour ───────────────────────────────────────────────────

// Extra details for a party with the Karigar role. Photo: Attachment
// (entityType "KARIGAR_PHOTO", entityId = partyId).
model KarigarProfile {
  party        Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId      String    @id
  employeeCode String?   @unique
  joiningDate  DateTime?
  notes        String?
  updatedAt    DateTime  @updatedAt
}

model KarigarDepartment {
  party        Party      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId      String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String

  @@id([partyId, departmentId])
  @@index([departmentId])
}

// Labour earned for one completed return, priced from the rate card in
// force on the work date. One per movement; amounts are frozen when created.
model LabourEntry {
  id           String          @id @default(cuid())
  movement     ProcessMovement @relation(fields: [movementId], references: [id])
  movementId   String          @unique
  party        Party           @relation(fields: [partyId], references: [id])
  partyId      String
  stage        ProcessStage?   @relation(fields: [stageId], references: [id])
  stageId      String?
  workDate     DateTime
  basis        RateBasis
  rate         Decimal         @db.Decimal(14, 2)
  quantity     Decimal         @db.Decimal(12, 3)
  amount       Decimal         @db.Decimal(14, 2)
  currency     String          @default("INR")
  // INR per 1 USD on the work date; null only on entries migrated from
  // before exchange rates were recorded.
  fxRate       Decimal?        @db.Decimal(12, 4)
  // RATE_CARD | ISSUE_RATE (priced at issue, pre-ERP) | LEGACY | ADJUSTED
  source       String
  rateCard     ProcessRate?    @relation(fields: [rateCardId], references: [id])
  rateCardId   String?
  note         String?
  payrollRun   PayrollRun?     @relation(fields: [payrollRunId], references: [id])
  payrollRunId String?
  voidedAt     DateTime?
  createdAt    DateTime        @default(now())

  @@index([partyId, workDate])
  @@index([payrollRunId])
  @@index([workDate])
}

enum AdjustmentType {
  ADVANCE
  DEDUCTION
  BONUS
}

// Money given to or taken from a karigar outside piece-rate labour: an
// advance (recovered from the next payroll), a deduction, or a bonus.
model KarigarAdjustment {
  id           String         @id @default(cuid())
  party        Party          @relation(fields: [partyId], references: [id])
  partyId      String
  date         DateTime
  type         AdjustmentType
  amount       Decimal        @db.Decimal(14, 2)
  currency     String         @default("INR")
  fxRate       Decimal?       @db.Decimal(12, 4)
  note         String?
  payrollRun   PayrollRun?    @relation(fields: [payrollRunId], references: [id])
  payrollRunId String?
  createdById  String
  voidedAt     DateTime?
  createdAt    DateTime       @default(now())

  @@index([partyId, date])
}

// A karigar paid for a period: the labour entries and adjustments it
// settles are linked to it and locked.
model PayrollRun {
  id             String              @id @default(cuid())
  party          Party               @relation(fields: [partyId], references: [id])
  partyId        String
  periodFrom     DateTime
  periodTo       DateTime
  labourTotal    Decimal             @db.Decimal(14, 2)
  bonusTotal     Decimal             @db.Decimal(14, 2)
  deductionTotal Decimal             @db.Decimal(14, 2)
  advanceTotal   Decimal             @db.Decimal(14, 2)
  net            Decimal             @db.Decimal(14, 2)
  currency       String              @default("INR")
  fxRate         Decimal?            @db.Decimal(12, 4)
  paidAt         DateTime
  paymentMode    String?
  paymentRef     String?
  createdById    String
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime            @default(now())
  labourEntries  LabourEntry[]
  adjustments    KarigarAdjustment[]

  @@index([partyId, periodFrom])
}

// An outside factory's (job-worker's) bill for work on issued stones.
model JobWorkBill {
  id          String            @id @default(cuid())
  party       Party             @relation(fields: [partyId], references: [id])
  partyId     String
  billNo      String
  date        DateTime
  amount      Decimal           @db.Decimal(14, 2)
  currency    String            @default("INR")
  fxRate      Decimal?          @db.Decimal(12, 4)
  notes       String?
  createdById String
  voidedAt    DateTime?
  createdAt   DateTime          @default(now())
  movements   ProcessMovement[]

  @@unique([partyId, billNo])
  @@index([date])
}

// Daily USD→INR rate (INR per 1 USD). Money entries copy the rate in force
// on their date, so later changes never rewrite history.
model ExchangeRate {
  date        DateTime @id @db.Date
  usdInr      Decimal  @db.Decimal(12, 4)
  createdById String?
  createdAt   DateTime @default(now())
}
